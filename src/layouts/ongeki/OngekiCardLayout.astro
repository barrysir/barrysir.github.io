---
import Layout from '@layouts/Layout.astro';
import Favicon from "@public/ongeki/favicon.png";
import { getParentUrl } from "@lib/url.ts";

const { pageTitle, headerTitle } = Astro.props;

const upAPage = getParentUrl(Astro.url);

---
<Layout pageTitle={pageTitle} favicon={Favicon.src}>
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans&display=swap" rel="stylesheet">
    <style is:global>
        body {
            font-family: 'Noto Sans', sans-serif;
            text-align: center;
            margin: 0;
            padding: 0;
            display: flex; flex-direction: column; align-items: center;
        }
        h1 {
            font-family: 'Noto Sans', Tahoma, Geneva, Verdana, sans-serif;
            font-weight: 500;
            font-size: 3em;
            margin-top: 20px;
        }
        .card {
            margin: 0px 20px;
            padding: 20px;
            border: 1px solid #ccc;
            border-radius: 8px;
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
            text-align: left;
        }
        ul {
            list-style-position: inside;
            margin: 0;
            padding-left: 30px;
        }
        a {
            color: #4a4;
        }
        a:hover {
            color: hsl(200, 43%, 47%);
        }

        /* styling card headers... sloppy, but idk */
        .card h2 {
            margin: 0px; 
            margin-bottom: 10px;
        }
    </style>
    
    <h1>{headerTitle ? headerTitle : '\u00A0'}</h1>
    <a class="mb-2" href={upAPage}>&lt;&lt; Back</a>
    <slot />
</Layout>